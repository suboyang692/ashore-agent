DASHSCOPE_API_KEY=sk-在这里粘贴你的百炼APIKey
# 免费额度模型以百炼控制台当前标注为准；换模型前先用 python -m app.inspect_llm --live 验证
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 向量模型单独配置；如果知识库重新入库，需保持一致并重建切片
EMBED_MODEL=text-embedding-v3

# 认证：JWT_SECRET 上线前必须换成随机长字符串
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=604800
# true = 所有业务接口必须带 Bearer Token；公开部署必须保持 true
REQUIRE_AUTH=true

# 固定窗口限流；Redis 不可用时自动使用进程内实现
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_AGENT_PER_MIN=5
RATE_LIMIT_SEARCH_PER_MIN=30
RATE_LIMIT_SUBMIT_PER_MIN=20

# MySQL 连接
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=在这里填你的MySQL密码
MYSQL_DB=ashore
# 生产 Compose 的 MySQL 容器 root 密码；本地连接仍使用 MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=change-me

# Redis（检索结果缓存 + 多轮会话记忆；docker compose up -d redis 启动）
# 连不上会自动降级为进程内缓存，业务不中断，/cache/stats 里 backend 会显示 memory
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_TIMEOUT=0.3
CACHE_TTL=3600
SESSION_TTL=86400
SESSION_MAX=20

# 生产 Web 入口端口（Nginx）
WEB_PORT=80
