DASHSCOPE_API_KEY=sk-在这里粘贴你的百炼APIKey
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# MySQL 连接（D1 建库用）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=在这里填你的MySQL密码
MYSQL_DB=ashore

# Redis（检索结果缓存 + 多轮会话记忆；docker compose up -d redis 启动）
# 连不上会自动降级为进程内缓存，业务不中断，/cache/stats 里 backend 会显示 memory
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_TIMEOUT=0.3
CACHE_TTL=3600
SESSION_TTL=86400
SESSION_MAX=20
